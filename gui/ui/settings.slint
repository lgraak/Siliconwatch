import { Button, CheckBox, ComboBox, LineEdit, SpinBox, ScrollView, TextEdit, Palette } from "std-widgets.slint";
import { ColumnSpec, Colors } from "common.slint";

component ConfirmationPanel inherits FocusScope {
    in property <string> preview;
    in property <bool> busy;
    in property <int> theme-index;
    callback confirmed();
    callback cancelled();
    forward-focus: confirmation;
    Timer {
        interval: 1ms;
        running: true;
        triggered => { self.running = false; confirmation.focus(); }
    }
    key-pressed(event) => { if event.text == Key.Escape && !root.busy { root.cancelled(); return accept; } return reject; }
    VerticalLayout {
        spacing: 10px;
        Text { text: "Review before applying"; color: Colors.text(root.theme-index); font-weight: 600; }
        TextEdit { text: root.preview; read-only: true; min-height: 150px; accessible-label: "Settings operation preview"; }
        HorizontalLayout {
            spacing: 10px;
            confirmation := Button { text: "Confirm"; enabled: !root.busy; clicked => { root.confirmed(); } }
            Button { text: "Cancel"; enabled: !root.busy; clicked => { root.cancelled(); } }
        }
    }
}

export component SettingsWindow inherits Window {
    icon: @image-url("../../assets/branding/siliconwatch-icon.png");
    title: "SiliconWatch — Settings";
    preferred-width: 780px;
    preferred-height: 760px;
    min-width: 640px;
    min-height: 480px;
    in-out property <int> theme-index: 0;
    in-out property <string> font-family: "system-ui";
    in-out property <int> font-size-px: 14;
    in-out property <bool> temperature-fahrenheit;
    in-out property <bool> minimize-to-tray: false;
    in-out property <int> main-width-px: 1120;
    in-out property <int> main-height-px: 680;
    in-out property <bool> main-maximized;
    in-out property <int> details-width-px: 960;
    in-out property <int> details-height-px: 720;
    in-out property <int> density-index: 0;
    in-out property <bool> row-separators: true;
    in-out property <bool> alternate-rows;
    in-out property <bool> default-expanded: true;
    in property <[ColumnSpec]> columns;
    in-out property <int> selected-column: 0;
    in-out property <int> column-width-px: 440;
    in-out property <string> path;
    in property <string> preview;
    in property <string> status;
    in-out property <bool> include-groups;
    in property <bool> confirming;
    in property <bool> busy;
    in property <string> ui-font-family;
    in property <length> ui-font-size: 14px;
    private property <int> page: 0;
    callback apply();
    callback close();
    callback import-settings();
    callback export-settings();
    callback reset-defaults();
    callback restore-backup();
    callback reload-config();
    callback review-groups();
    callback confirm();
    callback cancel-preview();
    callback move-column(int);
    callback column-selected(int);
    callback column-width-changed(int);
    background: Colors.canvas(root.theme-index);
    default-font-family: root.ui-font-family;
    default-font-size: root.ui-font-size;
    init => { Palette.color-scheme = root.theme-index == 2 ? ColorScheme.light : ColorScheme.dark; }
    changed theme-index => { Palette.color-scheme = root.theme-index == 2 ? ColorScheme.light : ColorScheme.dark; }
    public function focus-settings() { first-page.focus(); }
    FocusScope {
        key-pressed(event) => { if event.text == Key.Escape { if !root.busy { if root.confirming { root.cancel-preview(); } else { root.close(); } } return accept; } return reject; }
        VerticalLayout {
            padding: 16px;
            spacing: 10px;
            HorizontalLayout {
                Text { text: "Settings"; color: Colors.text(root.theme-index); font-size: 24px; font-weight: 600; }
                Rectangle { horizontal-stretch: 1; }
                Button { text: "Close"; enabled: !root.busy; clicked => { root.close(); } }
            }
            Text { text: "GUI preferences · Acquisition and security settings are unchanged"; color: Colors.secondary(root.theme-index); wrap: word-wrap; }
            HorizontalLayout {
                spacing: 8px;
                first-page := Button { text: "Appearance & Layout"; enabled: !root.confirming && !root.busy; clicked => { root.page = 0; } }
                Button { text: "Import, Export & Recovery"; enabled: !root.confirming && !root.busy; clicked => { root.page = 1; } }
            }
            if !root.status.is-empty: Text { text: root.status; color: Colors.caution(root.theme-index); wrap: word-wrap; }
            if !root.confirming: ScrollView {
                viewport-width: self.visible-width;
                vertical-stretch: 1;
                VerticalLayout {
                    spacing: 12px;
                    padding-right: 18px;
                    if root.page == 0: VerticalLayout {
                        spacing: 12px;
                        CheckBox {
                            text: "Minimize to Tray";
                            checked <=> root.minimize-to-tray;
                            enabled: !root.busy;
                            accessible-label: "Minimize to Tray; keep SiliconWatch running when Sensors closes if a tray is available";
                        }
                        Text { text: "Off by default. Without a usable tray, closing the last window exits."; color: Colors.secondary(root.theme-index); wrap: word-wrap; }
                        HorizontalLayout {
                            spacing: 12px;
                            Text { text: "Theme"; color: Colors.text(root.theme-index); width: 150px; }
                            ComboBox { model: ["OLED Black", "Dark", "Light"]; current-index <=> root.theme-index; enabled: !root.busy; accessible-label: "Theme"; }
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            Text { text: "Font family"; color: Colors.text(root.theme-index); width: 150px; }
                            LineEdit { text <=> root.font-family; enabled: !root.busy; accessible-label: "Font family; system-ui uses the system font"; }
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            Text { text: "Font size (px)"; color: Colors.text(root.theme-index); width: 150px; }
                            SpinBox { value <=> root.font-size-px; minimum: 10; maximum: 24; enabled: !root.busy; accessible-label: "Font size in logical pixels"; }
                            CheckBox { text: "Fahrenheit (°F)"; checked <=> root.temperature-fahrenheit; enabled: !root.busy; }
                        }
                        Text { text: "Window dimensions · logical pixels"; color: Colors.text(root.theme-index); font-weight: 600; }
                        HorizontalLayout {
                            spacing: 12px;
                            Text { text: "Main"; color: Colors.text(root.theme-index); width: 150px; }
                            SpinBox { value <=> root.main-width-px; minimum: 760; maximum: 4096; enabled: !root.busy; accessible-label: "Main window width"; }
                            Text { text: "×"; color: Colors.secondary(root.theme-index); }
                            SpinBox { value <=> root.main-height-px; minimum: 520; maximum: 2160; enabled: !root.busy; accessible-label: "Main window height"; }
                        }
                        CheckBox { text: "Start main window maximized"; checked <=> root.main-maximized; enabled: !root.busy; }
                        HorizontalLayout {
                            spacing: 12px;
                            Text { text: "Details"; color: Colors.text(root.theme-index); width: 150px; }
                            SpinBox { value <=> root.details-width-px; minimum: 640; maximum: 4096; enabled: !root.busy; accessible-label: "Details window width"; }
                            Text { text: "×"; color: Colors.secondary(root.theme-index); }
                            SpinBox { value <=> root.details-height-px; minimum: 480; maximum: 2160; enabled: !root.busy; accessible-label: "Details window height"; }
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            Text { text: "Sensor rows"; color: Colors.text(root.theme-index); width: 150px; }
                            ComboBox { model: ["Compact", "Comfortable"]; current-index <=> root.density-index; enabled: !root.busy; accessible-label: "Sensor row density"; }
                        }
                        HorizontalLayout {
                            spacing: 16px;
                            CheckBox { text: "Row separators"; checked <=> root.row-separators; enabled: !root.busy; }
                            CheckBox { text: "Alternate rows"; checked <=> root.alternate-rows; enabled: !root.busy; }
                        }
                        CheckBox { text: "Expand new device groups by default"; checked <=> root.default-expanded; enabled: !root.busy; }
                        Text { text: "Column order and width"; color: Colors.text(root.theme-index); font-weight: 600; }
                        for column[index] in root.columns: HorizontalLayout {
                            spacing: 8px;
                            Button { text: index == root.selected-column ? "● " + column.title : column.title; enabled: !root.busy; clicked => { root.selected-column = index; root.column-selected(index); } }
                            Text { text: round(column.width / 1px) + " px"; color: Colors.secondary(root.theme-index); horizontal-alignment: right; }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Button { text: "Move Left"; enabled: !root.busy && root.selected-column > 0; clicked => { root.move-column(-1); } }
                            Button { text: "Move Right"; enabled: !root.busy && root.selected-column < root.columns.length - 1; clicked => { root.move-column(1); } }
                            SpinBox { value <=> root.column-width-px; minimum: root.columns[root.selected-column].index == 0 ? 240 : 112; maximum: root.columns[root.selected-column].index == 0 ? 1024 : 512; enabled: !root.busy; accessible-label: "Selected column width in logical pixels"; edited(value) => { root.column-width-changed(value); } }
                        }
                        Text { text: "All five columns remain available. Quality and freshness labels stay visible."; color: Colors.secondary(root.theme-index); wrap: word-wrap; }
                    }
                    if root.page == 1: VerticalLayout {
                        spacing: 12px;
                        Text { text: "Portable GUI profile"; color: Colors.text(root.theme-index); font-weight: 600; }
                        Text { text: "Choose a local file by entering its full absolute path. Export suggests a filename; you choose the directory."; color: Colors.secondary(root.theme-index); wrap: word-wrap; }
                        LineEdit { text <=> root.path; placeholder-text: "/chosen/directory/siliconwatch-settings.toml"; enabled: !root.busy; accessible-label: "Import or export file absolute path"; }
                        CheckBox { text: "Include device group preferences in export"; checked <=> root.include-groups; enabled: !root.busy; }
                        Text { text: "Device preferences contain source identity evidence and require review on the destination installation."; color: Colors.secondary(root.theme-index); wrap: word-wrap; }
                        HorizontalLayout {
                            spacing: 10px;
                            Button { text: "Import Settings…"; enabled: !root.busy; clicked => { root.import-settings(); } }
                            Button { text: "Export Settings…"; enabled: !root.busy; clicked => { root.export-settings(); } }
                        }
                        Text { text: "Review and recovery"; color: Colors.text(root.theme-index); font-weight: 600; }
                        Button { text: "Review Device Group Matches…"; enabled: !root.busy; clicked => { root.review-groups(); } }
                        Button { text: "Reload from Disk…"; enabled: !root.busy; clicked => { root.reload-config(); } }
                        Button { text: "Restore Validated Backup…"; enabled: !root.busy; clicked => { root.restore-backup(); } }
                        Button { text: "Reset to Defaults…"; enabled: !root.busy; clicked => { root.reset-defaults(); } }
                        Text { text: "Import, restore and reset show a preview before replacing preferences. Session statistics and daemon behavior are preserved."; color: Colors.secondary(root.theme-index); wrap: word-wrap; }
                    }
                    Rectangle { vertical-stretch: 1; }
                }
            }
            if root.confirming: ConfirmationPanel {
                preview: root.preview;
                busy: root.busy;
                theme-index: root.theme-index;
                confirmed => { root.confirm(); }
                cancelled => { root.cancel-preview(); }
            }
            if !root.confirming: HorizontalLayout {
                Rectangle { horizontal-stretch: 1; }
                Button { text: "Apply Preferences"; enabled: !root.busy; clicked => { root.apply(); } }
                Button { text: "Cancel"; enabled: !root.busy; clicked => { root.close(); } }
            }
        }
    }
}
