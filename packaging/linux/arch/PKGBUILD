# Local Alpha 1 candidate packaging recipe. Not an AUR publication.
# The checked payload is assembled from the separately logged Rust 1.85 build.
pkgname=siliconwatch
pkgver=0.1.0alpha.1
pkgrel=1
pkgdesc='Read-only Linux hardware monitoring with CLI, foreground daemon and native GUI'
arch=('x86_64')
url='https://siliconwatch.cgillett.com/'
license=('GPL-3.0-only')
depends=(
  'glibc>=2.43'
  'libgcc'
  'fontconfig'
  'ttf-dejavu'
  'libglvnd'
  'libx11'
  'libxcb'
  'libxcursor'
  'libxi'
  'libxrender'
  'libxkbcommon'
  'libxkbcommon-x11'
  'wayland'
)
optdepends=('dbus: session bus for accessibility and optional StatusNotifier tray integration')
options=('!strip' '!debug')
source=('siliconwatch-0.1.0-alpha.1-arch-payload.tar')
sha256sums=('c888fafd93d278131f2146cacc7683e9f0be577c98d8c36f0409a4951d746d19')

package() {
  cp -a "$srcdir/payload/usr" "$pkgdir/"
}
