{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/lgraak/Siliconwatch/main/docs/api/local-v1.schema.json",
  "title": "SiliconWatch experimental local API v1 messages",
  "description": "Accepted requests and complete emitted responses, including embedded snapshot schema 2 and identity schema 1. Each object lists its required fields. An optional extension may be absent. Required nullable fields use explicit nulls. This strict emitter schema rejects additional properties; clients may tolerate additive response fields according to local-v1.md.",
  "$comment": "Validate parsed JSON after enforcing UTF-8, one LF-terminated frame, duplicate-key rejection and transport byte/deadline limits. JSON Schema cannot distinguish integer JSON spellings such as 1 and 1.0 after parsing, measure UTF-8 byte budgets, establish identity/permissions or verify timestamp arithmetic. The request parser additionally rejects floating-point version spellings. Decimal-string patterns bound unsigned integer ranges without binary64 narrowing. Nonfinite numbers are not protocol JSON. See local-v1.md for runtime and freshness semantics.",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/infoResponse"
    },
    {
      "$ref": "#/$defs/snapshotResponse"
    },
    {
      "$ref": "#/$defs/errorResponse"
    }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "properties": {
        "api_version": {
          "type": "integer",
          "const": 1
        },
        "method": {
          "enum": [
            "get_info",
            "get_snapshot"
          ]
        }
      },
      "required": [
        "api_version",
        "method"
      ],
      "additionalProperties": false,
      "description": "An accepted API v1 request. Unsupported versions or methods are invalid under this schema and receive the corresponding protocol error."
    },
    "instanceId": {
      "type": "string",
      "minLength": 32,
      "maxLength": 32,
      "pattern": "^[0-9a-f]{32}$",
      "description": "Public 128-bit instance token identifying this cache epoch; not an authentication secret."
    },
    "decimalU64": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20,
      "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615)(?![\\s\\S])",
      "description": "Canonical decimal string for an unsigned 64-bit quantity (0 through 18446744073709551615); no sign, leading zeros, fraction, exponent or trailing characters."
    },
    "decimalU128": {
      "type": "string",
      "minLength": 1,
      "maxLength": 39,
      "pattern": "^(?:0|[1-9][0-9]{0,37}|[1-2][0-9]{38}|3[0-3][0-9]{37}|340[0-1][0-9]{35}|3402[0-7][0-9]{34}|34028[0-1][0-9]{33}|340282[0-2][0-9]{32}|3402823[0-5][0-9]{31}|34028236[0-5][0-9]{30}|340282366[0-8][0-9]{29}|3402823669[0-1][0-9]{28}|340282366920[0-8][0-9]{26}|3402823669209[0-2][0-9]{25}|34028236692093[0-7][0-9]{24}|340282366920938[0-3][0-9]{23}|3402823669209384[0-5][0-9]{22}|34028236692093846[0-2][0-9]{21}|340282366920938463[0-3][0-9]{20}|3402823669209384634[0-5][0-9]{19}|34028236692093846346[0-2][0-9]{18}|340282366920938463463[0-2][0-9]{17}|3402823669209384634633[0-6][0-9]{16}|34028236692093846346337[0-3][0-9]{15}|340282366920938463463374[0-5][0-9]{14}|34028236692093846346337460[0-6][0-9]{12}|340282366920938463463374607[0-3][0-9]{11}|3402823669209384634633746074[0-2][0-9]{10}|340282366920938463463374607430[0-9]{9}|340282366920938463463374607431[0-6][0-9]{8}|3402823669209384634633746074317[0-5][0-9]{7}|34028236692093846346337460743176[0-7][0-9]{6}|340282366920938463463374607431768[0-1][0-9]{5}|34028236692093846346337460743176820[0-9]{4}|340282366920938463463374607431768210[0-9]{3}|340282366920938463463374607431768211[0-3][0-9]{2}|3402823669209384634633746074317682114[0-4][0-9]{1}|34028236692093846346337460743176821145[0-4]|340282366920938463463374607431768211455)(?![\\s\\S])",
      "description": "Canonical decimal string for an unsigned 128-bit nanosecond quantity. Compare offsets only within the same instance_id."
    },
    "positiveNanoseconds": {
      "allOf": [
        {
          "$ref": "#/$defs/decimalU128"
        },
        {
          "not": {
            "const": "0"
          }
        }
      ],
      "description": "Strictly positive configured freshness threshold in nanoseconds."
    },
    "text": {
      "type": "string",
      "maxLength": 16384,
      "description": "Preserved Unicode text or UTF-8 path. The server additionally enforces 16384 UTF-8 bytes per field and 262144 aggregate text/path bytes; JSON Schema maxLength counts characters and cannot express those byte budgets."
    },
    "nullableText": {
      "anyOf": [
        {
          "$ref": "#/$defs/text"
        },
        {
          "type": "null"
        }
      ]
    },
    "rawI64": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": -9223372036854775808,
      "maximum": 9223372036854775807,
      "description": "Exact signed 64-bit raw JSON integer or null. Clients must use lossless integer parsing; this field is not converted to a decimal string."
    },
    "finiteNumber": {
      "type": [
        "number",
        "null"
      ],
      "minimum": -1.7976931348623157e+308,
      "maximum": 1.7976931348623157e+308,
      "description": "Finite canonical f64 conversion or null, distinct from raw_value. Nonfinite JSON tokens are not valid protocol JSON."
    },
    "identityEvidence": {
      "type": "object",
      "properties": {
        "provider": {
          "$ref": "#/$defs/nullableText"
        },
        "parent": {
          "$ref": "#/$defs/nullableText"
        },
        "device_link": {
          "$ref": "#/$defs/nullableText"
        },
        "canonical_parent": {
          "$ref": "#/$defs/nullableText"
        },
        "channel": {
          "$ref": "#/$defs/nullableText"
        },
        "measurement": {
          "$ref": "#/$defs/nullableText"
        }
      },
      "required": [
        "provider",
        "parent",
        "device_link",
        "canonical_parent",
        "channel",
        "measurement"
      ],
      "additionalProperties": false
    },
    "identity": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "candidate": {
          "$ref": "#/$defs/nullableText"
        },
        "status": {
          "enum": [
            "best_effort",
            "insufficient_evidence",
            "unreadable_evidence",
            "conflicting_evidence",
            "ambiguous_channel",
            "collision"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/identityEvidence"
        },
        "issues": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/text"
          }
        }
      },
      "required": [
        "schema_version",
        "candidate",
        "status",
        "evidence",
        "issues"
      ],
      "additionalProperties": false,
      "description": "Unchanged identity schema 1. Candidate, status, evidence and issues must be retained together; a candidate is not proof of physical identity."
    },
    "sensor": {
      "type": "object",
      "properties": {
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "device": {
          "$ref": "#/$defs/text"
        },
        "device_path": {
          "$ref": "#/$defs/text"
        },
        "attribute": {
          "$ref": "#/$defs/text"
        },
        "label": {
          "$ref": "#/$defs/nullableText"
        },
        "source_path": {
          "$ref": "#/$defs/text"
        },
        "raw_text": {
          "$ref": "#/$defs/nullableText"
        },
        "raw_value": {
          "$ref": "#/$defs/rawI64"
        },
        "value": {
          "$ref": "#/$defs/finiteNumber"
        },
        "unit": {
          "$ref": "#/$defs/nullableText",
          "description": "Canonical unit string or null. Current acquisition conversions use °C, RPM, V, %, B, MHz, W and P-state."
        },
        "status": {
          "enum": [
            "ok",
            "unavailable",
            "permission_denied",
            "unsupported",
            "invalid",
            "error",
            "fault"
          ]
        },
        "error": {
          "$ref": "#/$defs/nullableText"
        }
      },
      "required": [
        "identity",
        "device",
        "device_path",
        "attribute",
        "label",
        "source_path",
        "raw_text",
        "raw_value",
        "value",
        "unit",
        "status",
        "error"
      ],
      "additionalProperties": false,
      "description": "Every unchanged sensor-schema field is present, including nulls and diagnostics. Row status remains authoritative even when service_current is true."
    },
    "warning": {
      "type": "object",
      "properties": {
        "path": {
          "$ref": "#/$defs/text"
        },
        "message": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "path",
        "message"
      ],
      "additionalProperties": false
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 2
        },
        "root": {
          "$ref": "#/$defs/text"
        },
        "sensors": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/sensor"
          }
        },
        "warnings": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "$ref": "#/$defs/warning"
          }
        }
      },
      "required": [
        "schema_version",
        "root",
        "sensors",
        "warnings"
      ],
      "additionalProperties": false,
      "description": "Complete unchanged snapshot schema 2, preserving row and warning ordering. The API rejects an over-limit response as a whole; it does not truncate arrays."
    },
    "attempt": {
      "type": "object",
      "properties": {
        "sequence": {
          "$ref": "#/$defs/decimalU64"
        },
        "started_ns": {
          "$ref": "#/$defs/decimalU128"
        },
        "finished_ns": {
          "$ref": "#/$defs/decimalU128"
        },
        "published_ns": {
          "$ref": "#/$defs/decimalU128"
        },
        "wall_start_unix_ms": {
          "anyOf": [
            {
              "$ref": "#/$defs/decimalU64"
            },
            {
              "type": "null"
            }
          ]
        },
        "wall_time_error": {
          "$ref": "#/$defs/nullableText"
        }
      },
      "required": [
        "sequence",
        "started_ns",
        "finished_ns",
        "published_ns",
        "wall_start_unix_ms",
        "wall_time_error"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "wall_start_unix_ms": {
              "$ref": "#/$defs/decimalU64"
            },
            "wall_time_error": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "wall_start_unix_ms": {
              "type": "null"
            },
            "wall_time_error": {
              "$ref": "#/$defs/text"
            }
          }
        }
      ],
      "description": "Observation metadata, not response-transmission or physical-sensor timestamps. started <= finished <= published; arithmetic ordering is specified in the protocol prose."
    },
    "acquisitionError": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/text"
        },
        "raw_os_error": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "message": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "kind",
        "raw_os_error",
        "message"
      ],
      "additionalProperties": false,
      "description": "Original acquisition diagnostic. kind is an opaque Rust I/O kind string, not a stable closed enum; message is not a machine-readable status."
    },
    "latest": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "empty"
            },
            "attempt": {
              "type": "null"
            },
            "error": {
              "type": "null"
            }
          },
          "required": [
            "state",
            "attempt",
            "error"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "succeeded"
            },
            "attempt": {
              "$ref": "#/$defs/attempt"
            },
            "error": {
              "type": "null"
            }
          },
          "required": [
            "state",
            "attempt",
            "error"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "failed"
            },
            "attempt": {
              "$ref": "#/$defs/attempt"
            },
            "error": {
              "$ref": "#/$defs/acquisitionError"
            }
          },
          "required": [
            "state",
            "attempt",
            "error"
          ],
          "additionalProperties": false
        }
      ]
    },
    "freshness": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "no_sensor_observations"
            },
            "lower_ns": {
              "type": "null"
            },
            "upper_ns": {
              "type": "null"
            }
          },
          "required": [
            "state",
            "lower_ns",
            "upper_ns"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "enum": [
                "within_budget",
                "stale"
              ]
            },
            "lower_ns": {
              "$ref": "#/$defs/decimalU128"
            },
            "upper_ns": {
              "$ref": "#/$defs/decimalU128"
            }
          },
          "required": [
            "state",
            "lower_ns",
            "upper_ns"
          ],
          "additionalProperties": false
        }
      ],
      "description": "Userspace observation-age bounds at assessment only. Stale means upper_ns > stale_after_ns; equality is within budget. No physical-age or receiving-time guarantee."
    },
    "observation": {
      "type": "object",
      "properties": {
        "attempt": {
          "$ref": "#/$defs/attempt"
        },
        "role": {
          "enum": [
            "latest_attempt",
            "historical_after_failure",
            "historical_after_stop"
          ]
        },
        "freshness": {
          "$ref": "#/$defs/freshness"
        },
        "snapshot": {
          "$ref": "#/$defs/snapshot"
        }
      },
      "required": [
        "attempt",
        "role",
        "freshness",
        "snapshot"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "snapshot": {
                "properties": {
                  "sensors": {
                    "maxItems": 0
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "freshness": {
                "properties": {
                  "state": {
                    "const": "no_sensor_observations"
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "freshness": {
                "properties": {
                  "state": {
                    "enum": [
                      "within_budget",
                      "stale"
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    },
    "snapshotResult": {
      "type": "object",
      "properties": {
        "lifecycle": {
          "enum": [
            "starting",
            "running",
            "stopping",
            "stopped"
          ]
        },
        "assessed_at_ns": {
          "$ref": "#/$defs/decimalU128"
        },
        "stale_after_ns": {
          "$ref": "#/$defs/positiveNanoseconds"
        },
        "producer": {
          "enum": [
            "active",
            "stopped"
          ]
        },
        "service_current": {
          "type": "boolean"
        },
        "physical_age_known": {
          "const": false
        },
        "latest": {
          "$ref": "#/$defs/latest"
        },
        "observation": {
          "anyOf": [
            {
              "$ref": "#/$defs/observation"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "lifecycle",
        "assessed_at_ns",
        "stale_after_ns",
        "producer",
        "service_current",
        "physical_age_known",
        "latest",
        "observation"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "lifecycle": {
                "const": "running"
              },
              "producer": {
                "const": "active"
              },
              "latest": {
                "properties": {
                  "state": {
                    "const": "succeeded"
                  }
                }
              },
              "observation": {
                "type": "object",
                "properties": {
                  "role": {
                    "const": "latest_attempt"
                  },
                  "freshness": {
                    "properties": {
                      "state": {
                        "const": "within_budget"
                      }
                    }
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "service_current": {
                "const": true
              }
            }
          },
          "else": {
            "properties": {
              "service_current": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "latest": {
                "properties": {
                  "state": {
                    "const": "empty"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "observation": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "latest": {
                "properties": {
                  "state": {
                    "const": "succeeded"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "observation": {
                "$ref": "#/$defs/observation"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "producer": {
                "const": "stopped"
              }
            }
          },
          "then": {
            "properties": {
              "observation": {
                "properties": {
                  "role": {
                    "const": "historical_after_stop"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "producer": {
                "const": "active"
              },
              "latest": {
                "properties": {
                  "state": {
                    "const": "failed"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "observation": {
                "properties": {
                  "role": {
                    "const": "historical_after_failure"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "producer": {
                "const": "active"
              },
              "latest": {
                "properties": {
                  "state": {
                    "const": "succeeded"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "observation": {
                "properties": {
                  "role": {
                    "const": "latest_attempt"
                  }
                }
              }
            }
          }
        }
      ],
      "description": "One point-in-time assessment. Acquisition failure is a successful API read; retained historical values keep their own successful attempt metadata. A stopping lifecycle overrides currentness without rewriting cache state."
    },
    "limits": {
      "type": "object",
      "properties": {
        "request_bytes": {
          "type": "integer",
          "const": 4096
        },
        "response_bytes": {
          "type": "integer",
          "const": 1048576
        },
        "active_clients": {
          "type": "integer",
          "const": 1
        },
        "request_deadline_ms": {
          "type": "integer",
          "const": 1000
        },
        "response_deadline_ms": {
          "type": "integer",
          "const": 2000
        },
        "max_sensors": {
          "type": "integer",
          "const": 4096
        },
        "max_warnings": {
          "type": "integer",
          "const": 1024
        },
        "max_identity_issues_per_sensor": {
          "type": "integer",
          "const": 64
        },
        "max_text_bytes": {
          "type": "integer",
          "const": 16384
        },
        "max_total_text_bytes": {
          "type": "integer",
          "const": 262144
        }
      },
      "required": [
        "request_bytes",
        "response_bytes",
        "active_clients",
        "request_deadline_ms",
        "response_deadline_ms",
        "max_sensors",
        "max_warnings",
        "max_identity_issues_per_sensor",
        "max_text_bytes",
        "max_total_text_bytes"
      ],
      "additionalProperties": false
    },
    "infoResult": {
      "type": "object",
      "properties": {
        "supported_versions": {
          "const": [
            1
          ]
        },
        "methods": {
          "const": [
            "get_info",
            "get_snapshot"
          ]
        },
        "snapshot_schema_version": {
          "type": "integer",
          "const": 2
        },
        "identity_schema_version": {
          "type": "integer",
          "const": 1
        },
        "read_only": {
          "const": true
        },
        "monitoring": {
          "type": "object",
          "properties": {
            "schema_version": { "const": 1 },
            "interval_ms": { "type": "integer", "minimum": 100, "maximum": 60000 },
            "stale_after_ms": { "type": "integer", "minimum": 1, "maximum": 18446744073709551615 }
          },
          "required": ["schema_version", "interval_ms", "stale_after_ms"],
          "additionalProperties": false
        },
        "limits": {
          "$ref": "#/$defs/limits"
        }
      },
      "required": [
        "supported_versions",
        "methods",
        "snapshot_schema_version",
        "identity_schema_version",
        "read_only",
        "limits"
      ],
      "additionalProperties": false
    },
    "infoResponse": {
      "type": "object",
      "properties": {
        "api_version": {
          "type": "integer",
          "const": 1
